# ==========================================================
#  Copiar este archivo a .env y completar UNA sola línea.
#
#      cp .env.example .env
#
#  El .env NO se sube al repositorio. Nunca se comparte por
#  WhatsApp ni por Drive: cada integrante arma el suyo.
#
#  Dudas y detalles:  docs/entorno/primeros-pasos.md
# ==========================================================
#
#  REGLAS DE FORMATO (rompen todo si no se respetan):
#    - NO poner comentarios en la misma línea que un valor.
#      El comentario se vuelve parte del valor.
#    - NO dejar espacios alrededor del "=".
#      La línea se descarta y la variable queda sin definir.
#
# ==========================================================


# ----------------------------------------------------------
#  1. LO ÚNICO QUE TENÉS QUE COMPLETAR
# ----------------------------------------------------------
#  Generá la tuya y pegala acá abajo. No copies la de otro.
#
#      python -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=


# ----------------------------------------------------------
#  2. BASE DE DATOS  —  ya viene lista, no la toques
# ----------------------------------------------------------
#  Apunta a tu contenedor local. Funciona tal cual con
#  "docker compose up -d".
#
#  El usuario es app_user y no postgres a propósito: postgres
#  ignora el aislamiento entre organizaciones.

DATABASE_URL=postgresql://app_user:app_local_pass@localhost:5432/plataforma

#  Supabase (demostración compartida). Sólo el Scrum Master la
#  usa, y sólo para aplicar migraciones. Para desarrollar del
#  día a día se usa la línea de arriba.
#
# DATABASE_URL=postgresql://app_user.REF_PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres


# ----------------------------------------------------------
#  3. DJANGO  —  ya viene listo, no lo toques
# ----------------------------------------------------------

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sólo hace falta en producción, y sólo si algún día se agrega una vista con
# sesión (el panel de administración de Django, que hoy no está instalado).
# La API autentica por JWT y no usa cookies, así que en local va vacía.
# En Railway sería: https://<tu-servicio>.up.railway.app
CSRF_TRUSTED_ORIGINS=


# ----------------------------------------------------------
#  3.b CORREO  —  US-03, el enlace de restablecimiento
# ----------------------------------------------------------
#  En local NO hace falta tocar nada: sin EMAIL_BACKEND, Django imprime el
#  correo en la consola donde corre `runserver`, y el enlace queda a la vista
#  para probar el flujo completo sin configurar ningún servidor de correo.
#
#  En producción se define EMAIL_BACKEND junto con las credenciales:
#  EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@centromedico.test

# A dónde apunta el enlace del correo: es la aplicación web, no la API. En
# local, el servidor de Vite.
FRONTEND_BASE_URL=http://localhost:5173

# ----------------------------------------------------------
#  4. ASISTENTE DE ORIENTACIÓN  —  US-31, Sprint 2
# ----------------------------------------------------------
# El asistente funciona **sin ninguna clave**: con los proveedores en `local`
# los embeddings se calculan con una función determinista que no sale a la
# red. Alcanza para levantar el proyecto, correr las pruebas y demostrar la
# recuperación. Ver backend/assistant/embeddings.py.
#
# Para usar Gemini de verdad, poné las dos variables en `gemini` y cargá la
# clave que saques de Google AI Studio (aistudio.google.com/apikey).
#
#   ASSISTANT_EMBEDDING_PROVIDER=gemini
#   ASSISTANT_CHAT_PROVIDER=gemini
#   GEMINI_API_KEY=<tu clave>
#
# ⚠️ Regla 11 del Sprint 2: **esta clave no entra al repositorio**, ni siquiera
# como valor "de ejemplo" que después alguien completa y commitea sin darse
# cuenta. Se queda vacía acá y se llena sólo en tu .env.
#
# Al cambiar de proveedor hay que **reindexar**: los vectores de dos modelos
# distintos no se pueden comparar entre sí.
#     python manage.py embed_catalog --organization <slug>

GEMINI_API_KEY=
ASSISTANT_EMBEDDING_PROVIDER=local
ASSISTANT_CHAT_PROVIDER=local
# Sólo si querés apartarte de lo que trae settings.py:
#   ASSISTANT_EMBEDDING_MODEL=gemini-embedding-001
#   ASSISTANT_CHAT_MODEL=gemini-3.5-flash-lite
#   ASSISTANT_MIN_SIMILARITY=0.62

# ----------------------------------------------------------
#  5. SE COMPLETAN MÁS ADELANTE  —  dejalas vacías
# ----------------------------------------------------------
#  DEFAULT_TENANT_ID   UUID de tu organización de trabajo.
#                      Existe recién cuando US-43 cree la primera.
#  STRIPE_*            Sprint 2 (pago de la ficha, US-18).
#  OPENAI_API_KEY      Ya no se usa: el asistente va con Gemini. Se deja
#                      declarada porque está en los .env que ya existen.
#  VITE_API_BASE_URL   Sprint 1. La lee Vite, no Django.

DEFAULT_TENANT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
VITE_API_BASE_URL=http://localhost:8000/api
