# ==========================================================
#  PLANTILLA — copiar a .env y completar con valores reales.
#  Este archivo SÍ va al repositorio. El .env NO.
# ==========================================================

# ---------- Django ----------
SECRET_KEY=cambiar-por-una-clave-generada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Base de datos ----------
# Desarrollo local (Docker Compose). El usuario es app_user,
# NO postgres: app_user no tiene BYPASSRLS y por eso las
# políticas de aislamiento multi-inquilino sí se aplican.
DATABASE_URL=postgresql://app_user:app_local_pass@localhost:5432/plataforma

# Demostración (Supabase). El valor real vive en las variables
# de entorno de Railway y en el gestor de contraseñas del equipo.
# Formato de referencia:
# DATABASE_URL=postgresql://app_user.REF_PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Puerto 5432 = Session pooler. NO usar 6543 (Transaction pooler):
# rompe las sentencias preparadas de Django.

# ---------- Multi-inquilino ----------
# UUID de la organización por defecto en desarrollo.
DEFAULT_TENANT_ID=

# ---------- Integraciones ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api
