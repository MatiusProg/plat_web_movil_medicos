# ==========================================================
#  Copiar este archivo a .env y completar UNA sola línea.
#
#      cp .env.example .env
#
#  El .env NO se sube al repositorio. Nunca se comparte por
#  WhatsApp ni por Drive: cada integrante arma el suyo.
#
#  Dudas y detalles:  docs/entorno/primeros-pasos.md
# ==========================================================
#
#  REGLAS DE FORMATO (rompen todo si no se respetan):
#    - NO poner comentarios en la misma línea que un valor.
#      El comentario se vuelve parte del valor.
#    - NO dejar espacios alrededor del "=".
#      La línea se descarta y la variable queda sin definir.
#
# ==========================================================


# ----------------------------------------------------------
#  1. LO ÚNICO QUE TENÉS QUE COMPLETAR
# ----------------------------------------------------------
#  Generá la tuya y pegala acá abajo. No copies la de otro.
#
#      python -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=


# ----------------------------------------------------------
#  2. BASE DE DATOS  —  ya viene lista, no la toques
# ----------------------------------------------------------
#  Apunta a tu contenedor local. Funciona tal cual con
#  "docker compose up -d".
#
#  El usuario es app_user y no postgres a propósito: postgres
#  ignora el aislamiento entre organizaciones.

DATABASE_URL=postgresql://app_user:app_local_pass@localhost:5432/plataforma

#  Supabase (demostración compartida). Sólo el Scrum Master la
#  usa, y sólo para aplicar migraciones. Para desarrollar del
#  día a día se usa la línea de arriba.
#
# DATABASE_URL=postgresql://app_user.REF_PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres


# ----------------------------------------------------------
#  3. DJANGO  —  ya viene listo, no lo toques
# ----------------------------------------------------------

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ----------------------------------------------------------
#  4. SE COMPLETAN MÁS ADELANTE  —  dejalas vacías
# ----------------------------------------------------------
#  DEFAULT_TENANT_ID   UUID de tu organización de trabajo.
#                      Existe recién cuando US-43 cree la primera.
#  STRIPE_*            Sprint 2 (pago de la ficha).
#  OPENAI_API_KEY      Sprint 3 (chatbot y resúmenes).
#  VITE_API_BASE_URL   Sprint 1. La lee Vite, no Django.

DEFAULT_TENANT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
VITE_API_BASE_URL=http://localhost:8000/api
